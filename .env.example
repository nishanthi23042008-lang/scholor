# GEMINI_API_KEY: Required for server-side Gemini AI explanations.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosted application URL injected at runtime.
APP_URL="MY_APP_URL"

# Optional Cybersecurity Threat Intelligence Keys (Server-Side Only)
# Google Safe Browsing API v4 key
GOOGLE_SAFE_BROWSING_API_KEY=""
# VirusTotal API v3 key (subject to VirusTotal usage and privacy terms)
VIRUSTOTAL_API_KEY=""

# Optional Transactional Email Service (e.g. Resend API for deadline/status reminders)
RESEND_API_KEY=""
EMAIL_FROM="ScholarShield Alerts <noreply@example.com>"

